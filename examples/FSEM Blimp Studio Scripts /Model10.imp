DATA: data1.csv;
VARIABLES: y y_bin y_nom y_cnt y_2pt m1 m2 m_nom m_bin x1 x2 x3 x4 xs1 xs2 xs3 xs4 xc1 xc2 xc3 xc4;
ORDINAL: xc1:xc4;
NOMINAL: m_nom;
MISSING: NA;
LATENT: eta;
MODEL:
eta ~ m_nom;
var(eta) ~ intercept@0 m_nom;
eta -> xc1@x1lo xc2:xc4;
xc3 ~~ xc4;
y ~ eta m_nom;
SEED: 90291;
BURN: 20000;
ITER: 20000;
