DATA: data1.csv;
VARIABLES: y y_bin y_nom y_cnt y_2pt m1 m2 m_nom m_bin x1 x2 x3 x4 xs1 xs2 xs3 xs4 xc1 xc2 xc3 xc4;
TRANSFORM:
u = ifelse(y_2pt == min(y_2pt), 0, 1);
yr = missing(u == 0, y_2pt);
ORDINAL: u xc1:xc4;
NOMINAL: m_nom;
MISSING: NA;
LATENT: eta;
MODEL:
eta ~ m_nom;
eta -> xc1:xc4;
xc3 ~~ xc4;
yjt(yr - 10) ~ eta m_nom;
u ~ eta m_nom;
SEED: 90291;
BURN: 40000;
ITER: 40000;
